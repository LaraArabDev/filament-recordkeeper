{
    "name": "laraarabdev/filament-recordkeeper",
    "description": "Filament 5 admin UI for laraarabdev/recordkeeper — audit resource, before/after diff viewer, timeline, stats widget, and permission-gated rollback.",
    "keywords": ["laravel", "filament", "filament-plugin", "audit", "auditing", "activity-log", "rollback", "recordkeeper"],
    "homepage": "https://github.com/LaraArabDev/filament-recordkeeper",
    "license": "MIT",
    "authors": [{"name": "LaraArabDev", "email": "dev@laraarab.dev", "role": "Developer"}],
    "repositories": [
        {
            "type": "path",
            "url": "../filament-recordkeeper",
            "options": {"symlink": true}
        }
    ],
    "require": {
        "php": "^8.2",
        "laraarabdev/recordkeeper": "@dev",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"LaraArabDev\\FilamentRecordkeeper\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"LaraArabDev\\FilamentRecordkeeper\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit --no-coverage"
    },
    "extra": {
        "laravel": {
            "providers": ["LaraArabDev\\FilamentRecordkeeper\\FilamentRecordkeeperServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
