includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
    ignoreErrors:
        # Trait used by consumer packages, not analysed in isolation
        -
            identifier: trait.unused

        # Core Audit model scopes (rollbackable, routeHits) called on Builder
        -
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder::(rollbackable|routeHits)\(\)#'
            paths:
                - src/Resources/Concerns/AuditTableFilters.php
                - src/Resources/Pages/ListAudits.php

        # view() function string not recognized as view-string
        -
            message: '#Parameter \#1 \$view of function view expects view-string\|null, string given#'
            path: src/Resources/Pages/ViewAudit.php

        # Dynamic properties from selectRaw aggregate aliases
        -
            message: '#Access to an undefined property LaraArabDev\\Recordkeeper\\Models\\Audit::\$(total|created|updated|deleted|routes|actors)#'
            path: src/Support/AuditFormatter.php
