includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
    excludePaths:
        - src/Filament
    checkMissingIterableValueType: false
    ignoreErrors:
        - '#Call to an undefined method OwenIt\\Auditing#'
        - '#Access to an undefined property#'
