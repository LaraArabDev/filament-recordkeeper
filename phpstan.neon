includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
    ignoreErrors:
        # Trait used by consumer packages, not analysed in isolation
        -
            identifier: trait.unused

        # Filament Tables/Infolists action classes not resolved by Larastan
        -
            message: '#Call to static method make\(\) on an unknown class Filament\\(Tables\\Actions|Infolists\\Components)\\#'
            paths:
                - src/Resources/AuditResource.php
                - src/RelationManagers/AuditsRelationManager.php

        # AuditFormatter::revertAction() returns Filament\Tables\Actions\Action (unresolved by Larastan)
        -
            messages:
                - '#has invalid return type Filament\\Tables\\Actions\\Action#'
                - '#Call to static method make\(\) on an unknown class Filament\\Tables\\Actions\\Action#'
            path: src/Support/AuditFormatter.php

        # Table::actions() type mismatch from mixed ViewAction/revertAction returns
        -
            message: '#Parameter \#1 \$actions of method Filament\\Tables\\Table::actions\(\)#'
            paths:
                - src/Resources/AuditResource.php
                - src/RelationManagers/AuditsRelationManager.php

        # Core Audit model scopes (rollbackable, routeHits) called on Builder
        -
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder::(rollbackable|routeHits)\(\)#'
            paths:
                - src/Resources/AuditResource.php
                - src/Resources/Pages/ListAudits.php

        # ViewRecord::getRecord() returns Model, but we know it's Audit — core methods and properties
        -
            messages:
                - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::(getModified|rollback)\(\)#'
                - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$(event|created_at)#'
            path: src/Resources/Pages/ViewAudit.php

        # view() function string not recognized as view-string
        -
            message: '#Parameter \#1 \$view of function view expects view-string\|null, string given#'
            path: src/Resources/Pages/ViewAudit.php

        # Dynamic properties from selectRaw aggregate aliases (total, created, updated, deleted, routes)
        -
            message: '#Access to an undefined property LaraArabDev\\Recordkeeper\\Models\\Audit::\$(total|created|updated|deleted|routes)#'
            path: src/Support/AuditFormatter.php
